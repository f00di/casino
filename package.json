{
  "name": "friendly-card-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev -w @friendly-card-room/web",
    "dev:server": "npm run dev -w @friendly-card-room/server",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @friendly-card-room/server",
    "migrate": "npm run migrate -w @friendly-card-room/server",
    "verify:audit": "npm run verify:audit -w @friendly-card-room/game-engine"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
